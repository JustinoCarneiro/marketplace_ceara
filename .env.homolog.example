# Marketplace Ceará — variáveis do ambiente de homologação LOCAL (docker-compose.homolog.yml).
# Este arquivo é só o MODELO: os valores secretos abaixo são placeholders. O .env.homolog de verdade
# NÃO é versionado (está no .gitignore) e nasce deste modelo, com segredos aleatórios, na 1ª vez que
# você roda `make homolog-up` (ou `make .env.homolog`). Se o .env.homolog já existe, nunca é sobrescrito.
# Exigências da aplicação: JWT_SECRET >= 32 caracteres; CPF_ENCRYPTION_KEY com exatamente 32 caracteres (AES-256); CPF_HASH_KEY >= 32 caracteres e DIFERENTE de CPF_ENCRYPTION_KEY.
# Nunca reutilize estes valores fora da sua máquina.
# Marketplace Ceará — Variáveis de homologação local
# Uso exclusivo em ambiente de desenvolvimento/homologação na máquina do dev.
# NÃO use estes valores em produção.

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=onda_user
POSTGRES_PASSWORD=TROQUE_ESTE_VALOR
POSTGRES_DB=onda_db

# ── JWT (min 32 chars) ────────────────────────────────────────────────────────
JWT_SECRET=TROQUE_ESTE_VALOR

# ── CPF encryption (AES-256 — exatamente 32 chars) ───────────────────────────
CPF_ENCRYPTION_KEY=TROQUE_ESTE_VALOR

# ── CPF hash (HMAC do CPF — chave PRÓPRIA, diferente da de cifra; mín. 32 chars) ─
CPF_HASH_KEY=TROQUE_ESTE_VALOR

# ── Webhook do gateway de pagamento ──────────────────────────────────────────
MARKETPLACE_WEBHOOK_SECRET=TROQUE_ESTE_VALOR
# Alerta do painel para repasses ainda pendentes; padrão 2 dias.
# MARKETPLACE_PAYOUT_OVERDUE_DAYS=2

# ── Usuário admin do Spring Security ─────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=TROQUE_ESTE_VALOR

# ── E-mail (alertas — deixe vazio para desabilitar em homolog) ────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Destinatário dos alertas operacionais ────────────────────────────────────
ADMIN_ALERT_EMAIL=admin@onda.dev

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@onda.dev
PGADMIN_PASSWORD=TROQUE_ESTE_VALOR
PROJECT_NAME=onda_homolog

# Endereço de remetente verificado no provedor; vazio mantém o fallback MAIL_USERNAME.
# No Resend: MAIL_USERNAME=resend e MAIL_FROM=contato@seu-dominio.
MAIL_FROM=
# true somente em demo; false exige canal externo configurado para iniciar.
ALLOW_MISSING_ALERT_CHANNEL=true

# M17 — mídia privada. Leia docs/CONFIGURACAO_STORAGE_EMAIL.md antes de ativar.
# stub apenas em seed/test/e2e; para R2, use s3 e region auto.
STORAGE_PROVIDER=stub
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_READ_URL_TTL_SECONDS=600

# IA do pedido (US14) — desligada por padrão; sem chave o app usa o fluxo manual.
MARKETPLACE_AI_ENABLED=false
MARKETPLACE_AI_API_KEY=
MARKETPLACE_AI_MODEL=gemini-2.5-flash
MARKETPLACE_AI_RATE_LIMIT_USER_HOURLY=5
MARKETPLACE_AI_RATE_LIMIT_USER_DAILY=20
MARKETPLACE_AI_RATE_LIMIT_GLOBAL_DAILY=200
