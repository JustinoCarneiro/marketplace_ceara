# Marketplace Ceará — variáveis do ambiente de demonstração pública (VPS/Coolify)
# Copie para .env.prod SÓ pra teste local do docker-compose.prod.yml — os valores reais
# usados na VPS ficam configurados direto nas env vars do Coolify, nunca commitados aqui.
# NUNCA commite o arquivo .env.prod (já está no .gitignore junto com .env*).

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=onda_user
POSTGRES_PASSWORD=troque-em-producao
POSTGRES_DB=onda_db

# ── JWT (min 32 chars) ────────────────────────────────────────────────────────
JWT_SECRET=troque-em-producao-min-32-caracteres-openssl-rand--base64-32

# ── CPF encryption (AES-256 — mínimo 32 bytes) ────────────────────────────────
CPF_ENCRYPTION_KEY=troque-em-producao-openssl-rand--base64-32

# ── Webhook do gateway de pagamento ──────────────────────────────────────────
MARKETPLACE_WEBHOOK_SECRET=troque-em-producao-openssl-rand--base64-32

# ── Admin do painel (login real, ROLE_ADMIN) ─────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=troque-em-producao

# ── Destinatário dos alertas operacionais (só exibido no painel — sem SMTP
#    configurado, ALLOW_MISSING_ALERT_CHANNEL=true no compose já cobre o boot) ─
ADMIN_ALERT_EMAIL=admin@onda.dev
