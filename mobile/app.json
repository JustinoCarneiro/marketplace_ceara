{
  "expo": {
    "name": "Onda",
    "slug": "onda-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.onda.marketplace",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Onda usa a câmera para anexar uma foto ao pedido.",
          "photosPermission": "O Onda acessa suas fotos para anexar uma imagem ao pedido."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Onda usa o microfone para gravar um áudio descrevendo o problema.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bcc17c4a-9f69-40b9-af45-a4d0b6c107a7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bcc17c4a-9f69-40b9-af45-a4d0b6c107a7",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
